<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.popnow</groupId>
  <artifactId>popnow-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>PopNow Java SDK</name>
  <description>Java client for the PopNow API: AI video, image, music and speech generation with Kling, Seedance, Wan, Nano Banana, GPT Image, Suno and more.</description>
  <url>https://github.com/popnow-ai/popnow-java</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>PopNow</name>
    <url>https://popnow.ai</url>
  </organization>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>PopNow</name>
      <email>support@popnow.ai</email>
      <url>https://popnow.ai</url>
      <organization>PopNow</organization>
      <organizationUrl>https://popnow.ai</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/popnow-ai/popnow-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/popnow-ai/popnow-java.git</developerConnection>
    <url>https://github.com/popnow-ai/popnow-java</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/popnow-ai/popnow-java/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!--
      The MINIMUM usable Jackson, not a recommended one. Maven's nearest-wins resolution lets the
      consumer's own Jackson take precedence, so this number only applies when they have none.
      2.12 is the release where record support landed; below it a record has no usable constructor
      and deserialisation fails. CI runs an extra pass against a recent version.
    -->
    <jackson.version>2.12.0</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!--
      A plain compile dependency, deliberately neither optional nor shaded: optional would make the
      first call fail with NoClassDefFoundError, and shading would turn jacksonModule()'s return
      type into an internal class nobody could register with their own ObjectMapper.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- A warning is a failure. -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
          <failOnWarning>true</failOnWarning>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
            <manifestEntries>
              <!-- Pin the module name so that renaming the JAR file is never a breaking change. -->
              <Automatic-Module-Name>ai.popnow</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Release profile, never active by default: sources and javadoc jars, GPG signing and the
      Central Portal upload. Normal `mvn verify` needs none of it and no GPG key.
      Not published yet; when it is, run `mvn -Prelease deploy` with credentials under server id
      "central" in settings.xml.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>all</doclint>
              <quiet>true</quiet>
              <notimestamp>true</notimestamp>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- Never prompt for a passphrase: nobody is there to answer in CI. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Confirm in the Central Portal by hand: a released version can never be withdrawn. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
